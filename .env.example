# Local development only. The API binds to loopback by default.
POSTGRES_DB=english_learning_db
POSTGRES_USER=english_learning_dev
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_PORT=5433
API_PORT=8080
API_BIND_ADDRESS=127.0.0.1
# Set locally to a unique base64-encoded random value of at least 32 bytes.
AUTH_JWT_SECRET=

# Optional Gmail SMTP credentials for password recovery. Fill only in a local environment.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
